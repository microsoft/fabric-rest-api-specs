{
  "swagger": "2.0",
  "info": {
    "version": "v1",
    "title": "Ontology data types"
  },
  "paths": {},
  "definitions": {
    "Ontologies": {
      "description": "A list of ontologies.",
      "required": [ "value" ],
      "type": "object",
      "properties": {
        "value": {
          "description": "A list of ontologies.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Ontology"
          }
        }
      },
      "allOf": [
        {
          "$ref": "../common/definitions.json#/definitions/PaginatedResponse"
        }
      ]
    },
    "Ontology": {
      "description": "An ontology object.",
      "type": "object",
      "required": [ "type" ],
      "allOf": [
        {
          "$ref": "../common/definitions.json#/definitions/Item"
        }
      ],
      "properties": {
        "properties": {
          "description": "The ontology properties.",
          "$ref": "#/definitions/OntologyProperties"
        }
      }
    },
    "OntologyProperties": {
      "description": "The properties of an ontology item.",
      "type": "object",
      "properties": {
        "generation": {
          "description": "The resolved ontology generation (`1` or `2`). The value reflects the generation created, regardless of creation mode.",
          "type": "integer",
          "format": "int32",
          "readOnly": true
        }
      }
    },
    "CreateOntologyRequest": {
      "description": "Create ontology request payload.",
      "required": [ "displayName" ],
      "properties": {
        "displayName": {
          "description": "The ontology display name. The display name must follow naming rules according to item type i.e., It should start with letter, only has numbers and letters or _ and is less than 100.",
          "type": "string",
          "readOnly": false
        },
        "description": {
          "description": "The ontology description. Maximum length is 256 characters.",
          "type": "string",
          "readOnly": false
        },
        "definition": {
          "description": "The [Ontology public definition](/rest/api/fabric/articles/item-management/definitions/ontology-definition).",
          "$ref": "#/definitions/OntologyDefinition",
          "readOnly": false
        },
        "sensitivityLabelSettings": {
          "description": "The sensitivity label settings for the Ontology.",
          "$ref": "../common/definitions.json#/definitions/SensitivityLabelSettings",
          "readOnly": false
        }
      }
    },
    "UpdateOntologyDefinitionRequest": {
      "description": "Update ontology public definition request payload.",
      "required": [ "definition" ],
      "properties": {
        "definition": {
          "$ref": "#/definitions/OntologyDefinition"
        }
      }
    },
    "OntologyDefinitionResponse": {
      "description": "Ontology public definition response.",
      "required": [ "definition" ],
      "properties": {
        "definition": {
          "$ref": "#/definitions/OntologyDefinition",
          "readOnly": true
        }
      }
    },
    "OntologyDefinition": {
      "description": "Ontology public definition object. Refer to this [article](/rest/api/fabric/articles/item-management/definitions/ontology-definition) for more details on the structure of the Ontology definition.",
      "type": "object",
      "required": [ "parts" ],
      "properties": {
        "format": {
          "description": "The format of the Ontology definition.",
          "type": "string",
          "readOnly": false
        },
        "parts": {
          "description": "A list of definition parts.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/OntologyDefinitionPart"
          },
          "readOnly": false
        }
      }
    },
    "OntologyDefinitionPart": {
      "description": "Ontology definition part object.",
      "type": "object",
      "required": [ "path", "payload", "payloadType" ],
      "properties": {
        "path": {
          "description": "The ontology part path.",
          "type": "string",
          "readOnly": false
        },
        "payload": {
          "description": "The ontology part payload.",
          "type": "string",
          "readOnly": false
        },
        "payloadType": {
          "description": "The payload type.",
          "$ref": "../common/definitions.json#/definitions/PayloadType",
          "readOnly": false
        }
      }
    },
    "UpdateOntologyRequest": {
      "description": "Update ontology request.",
      "properties": {
        "displayName": {
          "description": "The ontology display name. The display name must follow naming rules according to item type.",
          "type": "string",
          "readOnly": false
        },
        "description": {
          "description": "The ontology description. Maximum length is 256 characters.",
          "type": "string",
          "readOnly": false
        }
      }
    },
    "ItemVersions": {
      "description": "A list of item versions.",
      "required": [ "value" ],
      "type": "object",
      "properties": {
        "value": {
          "description": "A list of item versions in the current result page, ordered from newest to oldest.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/ItemVersion"
          },
          "readOnly": true
        }
      },
      "allOf": [
        {
          "$ref": "../common/definitions.json#/definitions/PaginatedResponse"
        }
      ]
    },
    "ItemVersion": {
      "description": "An item version object.",
      "type": "object",
      "required": [ "id", "displayName", "createdDateTime", "createdBy", "creationSource" ],
      "properties": {
        "id": {
          "description": "The version ID.",
          "type": "string",
          "format": "uuid",
          "readOnly": true
        },
        "displayName": {
          "description": "The display name of the version.",
          "type": "string",
          "maxLength": 100,
          "readOnly": false
        },
        "description": {
          "description": "The description of the version.",
          "type": "string",
          "maxLength": 500,
          "readOnly": false
        },
        "createdDateTime": {
          "description": "The time when the version was captured, in UTC, using the YYYY-MM-DDTHH:mm:ssZ format.",
          "type": "string",
          "format": "date-time",
          "readOnly": true
        },
        "createdBy": {
          "description": "The identity that created the version.",
          "$ref": "../common/definitions.json#/definitions/Principal",
          "readOnly": true
        },
        "creationSource": {
          "description": "The source that created the version.",
          "$ref": "#/definitions/ItemVersionCreationSource",
          "readOnly": false
        }
      }
    },
    "CreateItemVersionRequest": {
      "description": "The request payload for creating an item version.",
      "type": "object",
      "required": [ "displayName" ],
      "properties": {
        "displayName": {
          "description": "The display name of the version. The name does not need to be unique.",
          "type": "string",
          "maxLength": 100,
          "readOnly": false
        },
        "description": {
          "description": "The description of the version.",
          "type": "string",
          "maxLength": 500,
          "readOnly": false
        },
        "creationSource": {
          "description": "The source creating the version. The default value is `Manual`.",
          "$ref": "#/definitions/ItemVersionCreationSource",
          "readOnly": false
        }
      }
    },
    "UpdateItemVersionRequest": {
      "description": "The request payload for updating an item version.",
      "type": "object",
      "minProperties": 1,
      "properties": {
        "displayName": {
          "description": "The new display name of the version.",
          "type": "string",
          "maxLength": 100,
          "readOnly": false
        },
        "description": {
          "description": "The new description of the version.",
          "type": "string",
          "maxLength": 500,
          "readOnly": false
        }
      }
    },
    "RestoreItemVersionRequest": {
      "description": "The request payload for restoring an item version.",
      "type": "object",
      "properties": {
        "options": {
          "description": "The item-type-defined import options controlling how the stored definition is applied.",
          "type": "object",
          "readOnly": false
        }
      }
    },
    "ItemVersionCreationSource": {
      "description": "The source that created an item version. Additional item version creation source types may be added over time.",
      "type": "string",
      "enum": [ "Manual", "Automatic" ],
      "x-ms-enum": {
        "name": "ItemVersionCreationSource",
        "modelAsString": true,
        "values": [
          {
            "value": "Manual",
            "description": "The caller created the version as a manual action."
          },
          {
            "value": "Automatic",
            "description": "The caller created the version as part of an automated flow."
          }
        ]
      }
    }
  }
}
