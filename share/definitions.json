  "paths": {},
  "definitions": {
    "Share": {
      "description": "A share object.",
      "type": "object",
      "required": [
        "type"
      ],
      "allOf": [
        {
          "$ref": "../common/definitions.json#/definitions/Item"
        }
      ],
      "properties": {
        "properties": {
          "description": "The share properties.",
          "$ref": "#/definitions/ShareProperties",
          "readOnly": true
        }
      }
    },
    "ShareProperties": {
      "description": "The system-generated share properties.",
      "type": "object",
      "required": [
        "shareStatus",
        "shareVersion"
      ],
      "properties": {
        "invitationUrl": {
          "description": "The service-generated invitation URL. This property is available once the share has content and may be omitted for a newly created empty share.",
          "type": "string",
          "readOnly": true
        },
        "shareStatus": {
          "description": "The current status of the share. Additional ShareStatus values may be added over time.",
          "type": "string",
          "enum": [
            "Active",
            "Expired"
          ],
          "x-ms-enum": {
            "name": "ShareStatus",
            "modelAsString": true,
            "values": [
              {
                "value": "Active",
                "description": "The share is in its normal, non-expired lifecycle state. A share is active from creation, including when it is empty and doesn't have an invitation URL."
              },
              {
                "value": "Expired",
                "description": "The share's expiration policy elapsed and the share no longer grants access."
              }
            ]
          },
          "readOnly": true
        },
        "shareVersion": {
          "description": "The sequential, monotonically increasing share revision. The revision starts as the four-digit, zero-padded value `0001`, may grow beyond four digits, and increments whenever assets, recipients, or policies change.",
          "type": "string",
          "readOnly": true
        }
      }
    },
