    "UpdatePlaybookRequest": {
      "description": "The request payload for updating a Playbook.",
      "type": "object",
      "properties": {
        "displayName": {
          "description": "The Playbook display name. Because it is the root segment of every section and content-group path, a new value that would place an existing path or stored descendant beyond the OneLake storage path limits is rejected.",
